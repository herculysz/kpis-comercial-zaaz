		summarizeBy: none
		isNameInferred
		sourceColumn: mvp base_clientes[ajuste_cidade]

		annotation SummarizationSetBy = Automatic

	partition Cidades = calculated
		mode: import
		source =
				
				
				DISTINCT(
				    UNION(
				        VALUES('mvp base_clientes'[ajuste_cidade]),
				        VALUES('mvp solicitacao_servicos'[cidade])
				    )
				)

	annotation PBI_Id = 4fbf25d7041f4cd69667426c757d5ad2

